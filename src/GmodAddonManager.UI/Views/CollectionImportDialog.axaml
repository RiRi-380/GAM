<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="using:GmodAddonManager.UI.Localization"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="300"
        x:Class="GmodAddonManager.UI.Views.CollectionImportDialog"
        Title="{loc:Localize Dialog.CreateAsset}"
        Width="550"
        Height="400"
        MinHeight="400"
        CanResize="True"
        WindowStartupLocation="CenterOwner">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- アセット名入力 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{loc:Localize Dialog.AssetName}" 
                       FontWeight="Bold"
                       Margin="0,0,0,5"/>
            <TextBox x:Name="AssetNameTextBox" 
                     Text="{Binding AssetName}"
                     Watermark="{loc:Localize Dialog.AssetNamePlaceholder}"/>
        </StackPanel>
        
        <!-- アドオンコレクションからエクスポート -->
        <TabControl x:Name="ImportTabControl" Grid.Row="2">
            <TabItem Header="{loc:Localize CollectionImport.TabUrl}"
                     IsVisible="{Binding ShowSubscribeActions}">
                <Border Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}"
                        CornerRadius="8"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="{loc:Localize Collection.ImportFromCollection}" 
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Margin="0,0,0,10"/>
                        
                        <TextBlock Text="{loc:Localize Collection.EnterCollectionUrl}" 
                                   Opacity="0.8"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>
                        
                        <TextBox x:Name="CollectionUrlTextBox"
                                 Text="{Binding CollectionUrl}"
                                 Watermark="{loc:Localize CollectionImport.CollectionUrlPlaceholder}"
                                 KeyUp="OnCollectionUrlKeyUp"/>
                        
                        <!-- エラーメッセージ -->
                        <TextBlock x:Name="ErrorMessage"
                                   Text="{Binding ErrorMessage}"
                                   Foreground="Red"
                                   FontSize="12"
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding HasError}"/>
                        
                        <!-- インポートボタン -->
                        <Button x:Name="ImportButton"
                                Content="{loc:Localize Collection.LoadCollection}"
                                Command="{Binding LoadCollectionCommand}"
                                HorizontalAlignment="Right"
                                Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </TabItem>
            
            <TabItem Header="{loc:Localize CollectionImport.TabGam}">
                <Border Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}"
                        CornerRadius="8"
                        Padding="15">
                    <StackPanel>
                        <TextBlock Text="{loc:Localize CollectionImport.GamHeader}" 
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Margin="0,0,0,10"/>
                        
                        <TextBlock Text="{loc:Localize CollectionImport.GamDescription}" 
                                   Opacity="0.8"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox Grid.Column="0"
                                     x:Name="GamFilePathTextBox"
                                     Text="{Binding GamFilePath}"
                                     IsReadOnly="True"
                                     Watermark="{loc:Localize CollectionImport.GamFilePlaceholder}"
                                     Margin="0,0,10,0"/>
                            
                            <Button Grid.Column="1"
                                    Content="{loc:Localize Dialog.Browse}"
                                    Click="OnBrowseGamFile"/>
                        </Grid>
                        
                        <!-- GAMファイル情報 -->
                        <TextBlock x:Name="GamFileInfo"
                                   Text="{Binding GamFileInfo}"
                                   Opacity="0.8"
                                   FontSize="12"
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding HasGamFileInfo}"/>
                        
                        <!-- エラーメッセージ -->
                        <TextBlock x:Name="GamErrorMessage"
                                   Text="{Binding GamErrorMessage}"
                                   Foreground="Red"
                                   FontSize="12"
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding HasGamError}"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
        
        <!-- ボタン -->
        <StackPanel Grid.Row="4" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Spacing="10">
            <Button Content="{loc:Localize Dialog.Cancel}"
                    Click="OnCancel"/>
            <Button Content="{loc:Localize Dialog.Create}"
                    IsEnabled="{Binding CanCreate}"
                    Click="OnCreate"
                    Classes="accent"/>
        </StackPanel>
    </Grid>
</Window>
