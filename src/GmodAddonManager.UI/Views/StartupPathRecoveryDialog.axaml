<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="using:GmodAddonManager.UI.Localization"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="600"
        x:Class="GmodAddonManager.UI.Views.StartupPathRecoveryDialog"
        Title="{loc:Localize StartupPathRecovery.Title}"
        Width="760"
        Height="600"
        MinWidth="680"
        MinHeight="520"
        CanResize="True"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="22" RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock x:Name="HeadingText" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Opacity="0.78"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,18,0,18"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <Border Background="#242424" BorderBrush="#444444" BorderThickness="1" CornerRadius="6" Padding="14">
                    <Grid ColumnDefinitions="112,*" RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{loc:Localize StartupPathRecovery.PreviousPaths}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="GMod" Opacity="0.66"/>
                        <TextBlock x:Name="PreviousGmodText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" FontFamily="Consolas, monospace"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Workshop" Opacity="0.66" Margin="0,8,0,0"/>
                        <TextBlock x:Name="PreviousWorkshopText" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" FontFamily="Consolas, monospace" Margin="0,8,0,0"/>
                    </Grid>
                </Border>

                <Border Background="#242424" BorderBrush="#444444" BorderThickness="1" CornerRadius="6" Padding="14">
                    <Grid ColumnDefinitions="112,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{loc:Localize StartupPathRecovery.CandidatePaths}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="GMod" Opacity="0.66"/>
                        <TextBlock x:Name="CandidateGmodText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" FontFamily="Consolas, monospace"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Workshop" Opacity="0.66" Margin="0,8,0,0"/>
                        <TextBlock x:Name="CandidateWorkshopText" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" FontFamily="Consolas, monospace" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Localize StartupPathRecovery.Reason}" Opacity="0.66" Margin="0,12,0,0"/>
                        <TextBlock x:Name="ReasonText" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{loc:Localize StartupPathRecovery.BrowseHint}" TextWrapping="Wrap" Opacity="0.78" Margin="0,16,0,0"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" RowDefinitions="Auto,Auto">
            <TextBlock x:Name="StatusText" Grid.Row="0" TextWrapping="Wrap" Opacity="0.84" Margin="0,0,0,12"/>
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto">
                <Button Grid.Column="1" Content="{loc:Localize StartupPathRecovery.Browse}" MinWidth="120" Margin="0,0,10,0" Click="OnBrowse"/>
                <Button x:Name="UseButton" Grid.Column="2" Content="{loc:Localize StartupPathRecovery.UseThis}" MinWidth="130" Margin="0,0,10,0" Click="OnUse"/>
                <Button Grid.Column="3" Content="{loc:Localize StartupPathRecovery.Later}" MinWidth="90" Click="OnLater"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
