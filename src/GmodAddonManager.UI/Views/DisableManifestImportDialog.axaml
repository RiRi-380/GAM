<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GmodAddonManager.UI.ViewModels"
        xmlns:loc="using:GmodAddonManager.UI.Localization"
        mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="520"
        x:Class="GmodAddonManager.UI.Views.DisableManifestImportDialog"
        x:DataType="vm:DisableManifestImportViewModel"
        Title="{loc:Localize DisableManifest.Title}"
        Width="720"
        Height="520"
        MinWidth="680"
        MinHeight="500"
        CanResize="True"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22" RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="{loc:Localize DisableManifest.Title}"
                       FontSize="22"
                       FontWeight="SemiBold"/>
            <TextBlock Text="{loc:Localize DisableManifest.Description}"
                       TextWrapping="Wrap"
                       Opacity="0.78"/>
        </StackPanel>

        <Grid Grid.Row="1"
              Margin="0,18,0,0"
              ColumnDefinitions="*,Auto"
              RowDefinitions="Auto,Auto,Auto">
            <TextBox Grid.Row="0"
                     Grid.Column="0"
                     Text="{Binding FilePath}"
                     IsReadOnly="True"
                     Watermark="{loc:Localize DisableManifest.FileWatermark}"
                     Margin="0,0,10,0"/>
            <Button Grid.Row="0"
                    Grid.Column="1"
                    Content="{loc:Localize Dialog.Browse}"
                    MinWidth="92"
                    Click="OnBrowseFile"/>

            <TextBlock Grid.Row="1"
                       Grid.ColumnSpan="2"
                       Text="{Binding StatusMessage}"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"
                       Opacity="0.82"/>
            <TextBlock Grid.Row="2"
                       Grid.ColumnSpan="2"
                       Text="{Binding ErrorMessage}"
                       Foreground="#FF6B6B"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasError}"/>
        </Grid>

        <ScrollViewer Grid.Row="2" Margin="0,18,0,18">
            <StackPanel Spacing="14">
                <Border IsVisible="{Binding HasPreview}"
                        Background="#242424"
                        BorderBrush="#444444"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:Localize DisableManifest.Preview}"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Localize DisableManifest.PreviewDescription}"
                                       Opacity="0.68"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*,*"
                              RowDefinitions="Auto,Auto">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                <TextBlock Text="{loc:Localize DisableManifest.ValidIds}" Opacity="0.66"/>
                                <TextBlock Text="{Binding ValidCount}" FontSize="20" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2" Margin="18,0,0,0">
                                <TextBlock Text="{loc:Localize DisableManifest.Duplicates}" Opacity="0.66"/>
                                <TextBlock Text="{Binding DuplicateCount}" FontSize="20" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="2" Margin="18,0,0,0">
                                <TextBlock Text="{loc:Localize DisableManifest.InvalidLines}" Opacity="0.66"/>
                                <TextBlock Text="{Binding InvalidCount}" FontSize="20" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2" Margin="0,10,0,0">
                                <TextBlock Text="{loc:Localize DisableManifest.Apply}" Opacity="0.66"/>
                                <TextBlock Text="{Binding CanApplyText}" FontSize="16"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2" Margin="18,10,0,0">
                                <TextBlock Text="{loc:Localize DisableManifest.Mode}" Opacity="0.66"/>
                                <TextBlock Text="{Binding DisableModeText}" FontSize="16"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Spacing="2" Margin="18,10,0,0">
                                <TextBlock Text="{loc:Localize DisableManifest.InitialState}" Opacity="0.66"/>
                                <TextBlock Text="{loc:Localize DisableManifest.Off}" FontSize="16"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="120,*"
                              RowDefinitions="Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Localize DisableManifest.Asset}" Opacity="0.66"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AssetName}" TextWrapping="Wrap"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Localize DisableManifest.SampleIds}" Opacity="0.66" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SampleIds}" TextWrapping="Wrap" Margin="0,8,0,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Localize DisableManifest.InvalidDetails}" Opacity="0.66" IsVisible="{Binding HasInvalidLines}" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InvalidLineSummary}" TextWrapping="Wrap" IsVisible="{Binding HasInvalidLines}" Margin="0,8,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border IsVisible="{Binding HasPreview}"
                        Background="#1F2A33"
                        BorderBrush="#35516A"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14">
                    <TextBlock Text="{loc:Localize DisableManifest.Warning}"
                               TextWrapping="Wrap"
                               Opacity="0.9"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10">
            <Button Content="{loc:Localize Dialog.Close}"
                    MinWidth="88"
                    Click="OnClose"/>
            <Button Content="{loc:Localize DisableManifest.CreateAsset}"
                    MinWidth="124"
                    IsEnabled="{Binding CanApply}"
                    Click="OnApply"
                    Classes="accent"/>
        </StackPanel>
    </Grid>
</Window>
