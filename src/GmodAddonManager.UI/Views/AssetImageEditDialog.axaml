<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:GmodAddonManager.UI.Localization"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="700"
        x:Class="GmodAddonManager.UI.Views.AssetImageEditDialog"
        Title="{loc:Localize AssetEdit.ImageLabel}"
        Width="700"
        Height="700"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Spacing="6">
            <TextBlock Text="{loc:Localize AssetEdit.ImageLabel}"
                       FontWeight="Bold"/>
            <TextBlock Text="{loc:Localize AssetEdit.ImageDescription}"
                       FontSize="11"
                       Opacity="0.7"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,20,0,0">
            <Button Width="100"
                    Click="OnCancel"
                    Content="{loc:Localize Dialog.Cancel}"/>
            <Button x:Name="SaveButton"
                    Width="120"
                    Classes="accent"
                    Click="OnSave"
                    Content="{loc:Localize Dialog.Save}"/>
        </StackPanel>

        <Grid Margin="0,16,0,0" ColumnDefinitions="Auto,*">
            <StackPanel Grid.Column="0" Spacing="10">
                <Button x:Name="ResetButton"
                        Width="140"
                        Click="OnReset"
                        Content="{loc:Localize AssetEdit.ResetImage}"/>

                <TextBlock Text="{loc:Localize AssetEdit.Zoom}" Margin="0,6,0,0"/>
                <Slider x:Name="ZoomSlider" Minimum="1" Maximum="4" Value="1" Width="140"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Margin="16,0,0,0"
                    Padding="12"
                    Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                    CornerRadius="6">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border x:Name="CropViewport"
                            Width="420" Height="420"
                            CornerRadius="64"
                            BorderBrush="#4A90E2"
                            BorderThickness="2"
                            Background="Black"
                            ClipToBounds="True"
                            PointerPressed="OnCropPointerPressed"
                            PointerMoved="OnCropPointerMoved"
                            PointerReleased="OnCropPointerReleased"
                            PointerWheelChanged="OnCropPointerWheelChanged">
                        <Canvas>
                            <Image x:Name="CropImage" Stretch="None" RenderTransformOrigin="0,0">
                                <Image.RenderTransform>
                                    <MatrixTransform/>
                                </Image.RenderTransform>
                            </Image>
                        </Canvas>
                    </Border>
                    <Border Width="420" Height="420" CornerRadius="64"
                            BorderThickness="2"
                            BorderBrush="#4A90E2"
                            IsHitTestVisible="False"/>
                    <TextBlock x:Name="NoImageText"
                               Text="{loc:Localize AssetEdit.NoImage}"
                               Opacity="0.6"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
