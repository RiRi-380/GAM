<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
        xmlns:ia="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
        xmlns:loc="using:GmodAddonManager.UI.Localization"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="GmodAddonManager.UI.Views.VersionRestoreDetailsDialog"
        Title="{loc:Localize VersionRestoreDetails.Title}"
        Width="800"
        Height="600"
        WindowStartupLocation="CenterOwner">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- メインコンテンツ -->
        <Grid Grid.Row="0" Margin="10" IsVisible="{Binding ShowSubscribeInfo}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- サブスクライブするアドオン -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top"
                           Text="{loc:Localize VersionRestoreDetails.SubscribeHeader}"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>
                
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding AddonsToSubscribe}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E1E1E"
                                        BorderBrush="#303030"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,0,0,5"
                                        Padding="10"
                                        Cursor="Hand">
                                    <Border.Styles>
                                        <Style Selector="Border:pointerover">
                                            <Setter Property="Background" Value="#2A2A2A"/>
                                        </Style>
                                    </Border.Styles>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- サムネイル -->
                                        <Border Grid.Column="0"
                                                Width="64"
                                                Height="64"
                                                CornerRadius="4"
                                                ClipToBounds="True"
                                                Background="#1A1A1A">
                                            <Image Source="{Binding ThumbnailBitmap}"
                                                   Stretch="UniformToFill"
                                                   IsVisible="{Binding ThumbnailBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                            <Border.IsVisible>
                                                <Binding Path="IsThumbnailLoading" Converter="{x:Static BoolConverters.Not}"/>
                                            </Border.IsVisible>
                                        </Border>
                                        
                                        <!-- ローディングインジケーター -->
                                        <ProgressBar Grid.Column="0"
                                                     IsIndeterminate="True"
                                                     Width="50"
                                                     Height="4"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     IsVisible="{Binding IsThumbnailLoading}"/>
                                        
                                        <!-- アドオン情報 -->
                                        <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FileSizeText}"
                                                       FontSize="12"
                                                       Foreground="#888888"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    
                                    <i:Interaction.Behaviors>
                                        <ia:EventTriggerBehavior EventName="DoubleTapped">
                                            <ia:InvokeCommandAction Command="{Binding OpenWorkshopCommand}"/>
                                        </ia:EventTriggerBehavior>
                                    </i:Interaction.Behaviors>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
            
            <!-- セパレーター -->
            <Rectangle Grid.Column="1"
                       Width="1"
                       Fill="#303030"
                       VerticalAlignment="Stretch"/>
            
            <!-- サブスクライブ解除するアドオン -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top"
                           Text="{loc:Localize VersionRestoreDetails.UnsubscribeHeader}"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>
                
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding AddonsToUnsubscribe}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E1E1E"
                                        BorderBrush="#303030"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,0,0,5"
                                        Padding="10"
                                        Cursor="Hand">
                                    <Border.Styles>
                                        <Style Selector="Border:pointerover">
                                            <Setter Property="Background" Value="#2A2A2A"/>
                                        </Style>
                                    </Border.Styles>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- サムネイル -->
                                        <Border Grid.Column="0"
                                                Width="64"
                                                Height="64"
                                                CornerRadius="4"
                                                ClipToBounds="True"
                                                Background="#1A1A1A">
                                            <Image Source="{Binding ThumbnailBitmap}"
                                                   Stretch="UniformToFill"
                                                   IsVisible="{Binding ThumbnailBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                            <Border.IsVisible>
                                                <Binding Path="IsThumbnailLoading" Converter="{x:Static BoolConverters.Not}"/>
                                            </Border.IsVisible>
                                        </Border>
                                        
                                        <!-- ローディングインジケーター -->
                                        <ProgressBar Grid.Column="0"
                                                     IsIndeterminate="True"
                                                     Width="50"
                                                     Height="4"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     IsVisible="{Binding IsThumbnailLoading}"/>
                                        
                                        <!-- アドオン情報 -->
                                        <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FileSizeText}"
                                                       FontSize="12"
                                                       Foreground="#888888"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    
                                    <i:Interaction.Behaviors>
                                        <ia:EventTriggerBehavior EventName="DoubleTapped">
                                            <ia:InvokeCommandAction Command="{Binding OpenWorkshopCommand}"/>
                                        </ia:EventTriggerBehavior>
                                    </i:Interaction.Behaviors>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
        
        <!-- 閉じるボタン -->
        <Button Grid.Row="1"
                Content="{loc:Localize Dialog.Close}"
                Width="100"
                HorizontalAlignment="Center"
                Margin="0,10,0,20"
                Click="OnCloseClick"/>
    </Grid>
</Window>
