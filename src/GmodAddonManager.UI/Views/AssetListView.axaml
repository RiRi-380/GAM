<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GmodAddonManager.UI.ViewModels"
             xmlns:loc="using:GmodAddonManager.UI.Localization"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="450"
             x:Class="GmodAddonManager.UI.Views.AssetListView"
             x:DataType="vm:AssetListViewModel">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- ヘッダー -->
        <Border Grid.Row="0" 
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                Padding="15"
                MinHeight="70">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" 
                           Text="{loc:Localize AssetList.Header}" 
                           FontSize="16" 
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button Command="{Binding ImportAssetCommand}"
                            ToolTip.Tip="{loc:Localize AssetList.ImportTooltip}"
                            Padding="10,4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{StaticResource ImportIcon}" Width="12" Height="12"/>
                            <TextBlock Text="{loc:Localize AssetList.Import}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CreateAssetCommand}"
                            Content="{loc:Localize AssetList.CreateNew}"
                            ToolTip.Tip="{loc:Localize AssetList.CreateNewTooltip}"
                            Classes="accent"
                            Padding="12,4"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- アセットリスト -->
        <ScrollViewer Grid.Row="1"
                      Name="AssetScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsRepeater ItemsSource="{Binding Assets}" Margin="5">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" Spacing="4"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:AssetItemViewModel">
                        <Border Margin="0,2" 
                                Padding="10,2"
                                Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                                CornerRadius="4"
                                BorderThickness="2"
                                BorderBrush="{Binding BorderColor}"
                                Classes.selected="{Binding IsSelected}"
                                PointerPressed="OnAssetPointerPressed"
                                >
                            
                            <Border.Styles>
                                <Style Selector="Border.selected">
                                    <Setter Property="Background" Value="#3A3A3A"/>
                                </Style>
                                <Style Selector="Border:pointerover">
                                    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListMediumBrush}"/>
                                </Style>
                            </Border.Styles>
                            
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                    
                                <!-- アセットサムネイル -->
                                <Border Grid.Column="0"
                                        Grid.RowSpan="2"
                                        Width="64"
                                        Height="64"
                                        Margin="0,0,8,0"
                                        BoxShadow="0 2 6 0 #20000000"
                                        ClipToBounds="True"
                                        VerticalAlignment="Center"
                                        Classes="assetImage"
                                        Classes.hasImage="{Binding HasCustomImage}"
                                        PointerPressed="OnAssetImagePointerPressed"
                                        Cursor="Hand"
                                        ToolTip.Tip="{loc:Localize AssetList.Edit}"
                                        IsHitTestVisible="{Binding CanEditImage}">
                                    <Border.Styles>
                                        <Style Selector="Border.assetImage">
                                            <Setter Property="CornerRadius" Value="10"/>
                                            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>
                                        </Style>
                                        <Style Selector="Border.assetImage.hasImage">
                                            <Setter Property="CornerRadius" Value="10"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Style>
                                    </Border.Styles>
                                    <Grid>
                                        <Image Source="{Binding AssetImageBitmap}"
                                               Stretch="UniformToFill"
                                               IsVisible="{Binding HasCustomImage}"/>
                                        <Border IsVisible="{Binding HasNoCustomImage}"
                                                Background="{DynamicResource SystemControlBackgroundListLowBrush}">
                                            <Grid>
                                                <TextBlock Text="{Binding Name, Converter={StaticResource FirstCharacterConverter}}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="22"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                                           Opacity="0.9"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- アセット情報 -->
                                <Grid Grid.Column="1"
                                      Grid.Row="0"
                                      ColumnDefinitions="Auto,*"
                                      RowDefinitions="Auto,Auto"
                                      VerticalAlignment="Center">
                                    <Border Grid.Row="0"
                                            Grid.Column="0"
                                            Width="10"
                                            Height="10"
                                            Margin="0,0,8,0"
                                            Background="Transparent"
                                            VerticalAlignment="Center">
                                        <Ellipse Width="10"
                                                Height="10"
                                                Fill="{Binding AssetStateColor}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Row="0"
                                              Grid.Column="1"
                                              Text="{Binding Name}" 
                                              FontSize="16"
                                              FontWeight="Bold"
                                              Classes.selected="{Binding IsSelected}">
                                        <TextBlock.Styles>
                                            <Style Selector="TextBlock.selected">
                                                <Setter Property="Foreground" Value="White"/>
                                            </Style>
                                        </TextBlock.Styles>
                                    </TextBlock>
                                        
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock FontSize="11" 
                                                  Opacity="0.7"
                                                  Classes.selected="{Binding IsSelected}"
                                                  Text="{Binding AddonCountDisplay}">
                                            <TextBlock.Styles>
                                                <Style Selector="TextBlock.selected">
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="Opacity" Value="0.9"/>
                                                </Style>
                                            </TextBlock.Styles>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>

                                <!-- アセット状態 -->
                                <Grid Grid.Column="1"
                                      Grid.Row="1"
                                      ColumnDefinitions="Auto,*"
                                      VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0"
                                               Orientation="Horizontal"
                                               IsVisible="{Binding CanEditAddonDefaultState}">
                                        <RadioButton GroupName="{Binding Id, StringFormat=AssetState_{0}}"
                                                    Content="{loc:Localize AssetList.Enabled}"
                                                    IsChecked="{Binding IsEnabledState}"
                                                    Command="{Binding SetEnabledCommand}"
                                                    Margin="0,0,8,0"
                                                    FontSize="11">
                                            <RadioButton.Styles>
                                                <Style Selector="RadioButton:checked">
                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                </Style>
                                            </RadioButton.Styles>
                                        </RadioButton>
                                        <RadioButton GroupName="{Binding Id, StringFormat=AssetState_{0}}"
                                                    Content="{loc:Localize AssetList.Disabled}"
                                                    IsChecked="{Binding IsDisabledState}"
                                                    Command="{Binding SetDisabledCommand}"
                                                    Margin="0,0,8,0"
                                                    FontSize="11">
                                            <RadioButton.Styles>
                                                <Style Selector="RadioButton:checked">
                                                    <Setter Property="Foreground" Value="#FF9800"/>
                                                </Style>
                                            </RadioButton.Styles>
                                        </RadioButton>
                                        <RadioButton GroupName="{Binding Id, StringFormat=AssetState_{0}}"
                                                    Content="{loc:Localize AssetList.Excluded}"
                                                    IsChecked="{Binding IsExcludedState}"
                                                    Command="{Binding SetExcludedCommand}"
                                                    Margin="0,0,8,0"
                                                    FontSize="11">
                                            <RadioButton.Styles>
                                                <Style Selector="RadioButton:checked">
                                                    <Setter Property="Foreground" Value="#F44336"/>
                                                </Style>
                                            </RadioButton.Styles>
                                        </RadioButton>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Command="{Binding ApplyExclusiveCommand}"
                                            Content="{loc:Localize AssetList.ApplyExclusive}"
                                            ToolTip.Tip="{loc:Localize AssetList.ApplyExclusiveTooltip}"
                                            IsVisible="{Binding CanApplyExclusive}"
                                            Padding="8,4"
                                            FontSize="11"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"/>
                                </Grid>
                                    
                                <!-- バージョン + 共有ボタン -->
                                <StackPanel Grid.Column="2"
                                            Grid.Row="0"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Spacing="6">
                                    <Button Content="{Binding VersionDisplay}"
                                            Command="{Binding VersionManageCommand}"
                                            IsVisible="{Binding CanManageVersions}"
                                            MinWidth="40"
                                            Height="26"
                                            FontSize="12"
                                            Padding="8,4"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            ToolTip.Tip="{loc:Localize AssetList.ManageVersionsTooltip}"/>
                                    <Button Command="{Binding ShareCommand}"
                                            Width="24" Height="24"
                                            ToolTip.Tip="{Binding ShareButtonText}"
                                            IsVisible="{Binding CanShare}">
                                        <PathIcon Width="12" Height="12"
                                                 Data="{StaticResource cloud-upload}"/>
                                    </Button>
                                </StackPanel>
                                    
                                <!-- 削除ボタン -->
                                <StackPanel Grid.Column="2"
                                            Grid.Row="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Spacing="6">
                                    <Button Command="{Binding DeleteCommand}"
                                            Width="24" Height="24"
                                            ToolTip.Tip="{loc:Localize AssetList.DeleteTooltip}"
                                            IsVisible="{Binding CanDelete}">
                                        <PathIcon Data="{StaticResource DeleteIcon}" Width="12" Height="12"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
        
        <!-- ジャンクションアセット（下部表示） -->
        <Border Grid.Row="2" 
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                IsVisible="{Binding ShowJunctionAsset}">
            <ItemsControl ItemsSource="{Binding JunctionAsset}" Margin="5">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AssetItemViewModel">
                        <Border Margin="0,2" 
                                Padding="10,8"
                                Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                                CornerRadius="4"
                                Classes.selected="{Binding IsSelected}"
                                PointerPressed="OnAssetPointerPressed">
                            
                            <Border.Styles>
                                <Style Selector="Border.selected">
                                    <Setter Property="Background" Value="#3A3A3A"/>
                                </Style>
                                <Style Selector="Border:pointerover">
                                    <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListMediumBrush}"/>
                                </Style>
                            </Border.Styles>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- ジャンクションアイコン -->
                                <TextBlock Grid.Column="0" 
                                          Text="迫" 
                                          FontSize="16"
                                          Margin="0,0,8,0"
                                          VerticalAlignment="Center"/>
                                
                                <!-- アセット情報 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" 
                                              FontSize="16"
                                              FontWeight="Bold"
                                              Classes.selected="{Binding IsSelected}">
                                        <TextBlock.Styles>
                                            <Style Selector="TextBlock.selected">
                                                <Setter Property="Foreground" Value="White"/>
                                            </Style>
                                        </TextBlock.Styles>
                                    </TextBlock>
                                    
                                    <TextBlock FontSize="11" 
                                              Opacity="0.7"
                                              Classes.selected="{Binding IsSelected}"
                                              Text="{Binding DisabledAddonCountDisplay}">
                                        <TextBlock.Styles>
                                            <Style Selector="TextBlock.selected">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="Opacity" Value="0.9"/>
                                            </Style>
                                        </TextBlock.Styles>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</UserControl>
