<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GmodAddonManager.UI.ViewModels"
        xmlns:loc="using:GmodAddonManager.UI.Localization"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
        x:Class="GmodAddonManager.UI.Views.AssetSelectionDialog"
        Title="{loc:Localize AssetSelection.Title}"
        Width="400"
        Height="450"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    
    <DockPanel Margin="10">
        <!-- ヘッダー -->
        <TextBlock DockPanel.Dock="Top" 
                  Text="{loc:Localize AssetSelection.SelectPrompt}" 
                  FontSize="14"
                  FontWeight="Bold"
                  Margin="0,0,0,10"/>
        
        <!-- ボタン -->
        <DockPanel DockPanel.Dock="Bottom"
                   Margin="0,10,0,0">
            <Button Name="CreateAssetButton"
                    DockPanel.Dock="Left"
                    Content="{loc:Localize AssetList.CreateNew}"
                    Height="32"
                    Click="OnCreateAssetClick"
                    IsVisible="False"/>
            <StackPanel Orientation="Horizontal"
                       HorizontalAlignment="Right"
                       Spacing="10">
                <Button Name="CancelButton"
                        Content="{loc:Localize Dialog.Cancel}"
                        Width="100"
                        Height="32"
                        Click="OnCancelClick"/>
                <Button Name="OkButton"
                        Content="{loc:Localize Dialog.Add}"
                        Width="100"
                        Height="32"
                        IsEnabled="False"
                        Click="OnOkClick"
                        Classes="accent"/>
            </StackPanel>
        </DockPanel>
        
        <!-- アセットリスト -->
        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <ListBox Name="AssetListBox"
                     SelectionMode="Single"
                     SelectionChanged="OnSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AssetItemViewModel">
                        <Border Padding="10,8"
                                Background="Transparent">
                            <Grid ColumnDefinitions="Auto,*">
                                <!-- アイコン -->
                                <Border Grid.Column="0"
                                        Width="32" Height="32"
                                        Margin="0,0,10,0"
                                        ClipToBounds="True"
                                        Classes="assetImage"
                                        Classes.hasImage="{Binding HasCustomImage}">
                                    <Border.Styles>
                                        <Style Selector="Border.assetImage">
                                            <Setter Property="CornerRadius" Value="4"/>
                                            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
                                        </Style>
                                        <Style Selector="Border.assetImage.hasImage">
                                            <Setter Property="CornerRadius" Value="4"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Style>
                                    </Border.Styles>
                                    <Grid>
                                        <Image Source="{Binding AssetImageBitmap}"
                                               Stretch="UniformToFill"
                                               IsVisible="{Binding HasCustomImage}"/>
                                        <Border IsVisible="{Binding HasNoCustomImage}"
                                                Background="{DynamicResource SystemControlBackgroundListLowBrush}">
                                            <TextBlock Text="{Binding Name, Converter={StaticResource FirstCharacterConverter}}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      FontSize="16"
                                                      FontWeight="Bold"
                                                      Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                
                                <!-- 情報 -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                              FontWeight="Bold"
                                              FontSize="14"
                                              MaxLines="1"
                                              TextTrimming="CharacterEllipsis"
                                              ToolTip.Tip="{Binding Name}"/>
                                    <TextBlock Text="{Binding AddonCountDisplay}"
                                               Opacity="0.7"
                                               FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentLowBrush}"/>
                    </Style>
                </ListBox.Styles>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
