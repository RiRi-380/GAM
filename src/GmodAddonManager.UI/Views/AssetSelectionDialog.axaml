<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GmodAddonManager.UI.ViewModels"
        xmlns:loc="using:GmodAddonManager.UI.Localization"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
        x:Class="GmodAddonManager.UI.Views.AssetSelectionDialog"
        Title="{loc:Localize AssetSelection.Title}"
        Width="400"
        Height="450"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    
    <DockPanel Margin="10">
        <!-- ヘッダー -->
        <TextBlock DockPanel.Dock="Top" 
                  Text="{loc:Localize AssetSelection.SelectPrompt}" 
                  FontSize="14"
                  FontWeight="Bold"
                  Margin="0,0,0,10"/>
        
        <!-- ボタン -->
        <StackPanel DockPanel.Dock="Bottom" 
                   Orientation="Horizontal" 
                   HorizontalAlignment="Right"
                   Margin="0,10,0,0"
                   Spacing="10">
            <Button Name="CancelButton"
                    Content="{loc:Localize Dialog.Cancel}"
                    Width="100"
                    Height="32"
                    Click="OnCancelClick"/>
            <Button Name="OkButton"
                    Content="{loc:Localize Dialog.Add}"
                    Width="100"
                    Height="32"
                    IsEnabled="False"
                    Click="OnOkClick"
                    Classes="accent"/>
        </StackPanel>
        
        <!-- アセットリスト -->
        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <ListBox Name="AssetListBox"
                     SelectionMode="Single"
                     SelectionChanged="OnSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AssetItemViewModel">
                        <Border Padding="10,8"
                                Background="Transparent">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <!-- アイコン -->
                                <Border Width="32" Height="32"
                                        CornerRadius="4">
                                    <Border.Background>
                                        <SolidColorBrush Color="{Binding Id, Converter={StaticResource AssetIdToColorConverter}}"/>
                                    </Border.Background>
                                    <TextBlock Text="{Binding Name, Converter={StaticResource FirstCharacterConverter}}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              FontSize="16"
                                              FontWeight="Bold"
                                              Foreground="White"/>
                                </Border>
                                
                                <!-- 情報 -->
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                              FontWeight="Bold"
                                              FontSize="14"/>
                                    <TextBlock Opacity="0.7"
                                              FontSize="12">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} addons">
                                                <Binding Path="AddonCount"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentLowBrush}"/>
                    </Style>
                </ListBox.Styles>
            </ListBox>
        </Border>
    </DockPanel>
</Window>