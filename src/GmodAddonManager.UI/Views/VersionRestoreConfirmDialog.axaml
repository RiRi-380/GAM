<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="250"
        x:Class="GmodAddonManager.UI.Views.VersionRestoreConfirmDialog"
        Title="バージョン復元"
        Width="500"
        Height="250"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    
    <DockPanel>
        <!-- ボタンパネル（下部に固定） -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="10"
                    Margin="0,10,0,20">
            
            <Button Name="YesButton"
                    Content="はい"
                    Width="80"
                    IsDefault="True"
                    Click="OnYesClick"/>
            
            <Button Name="NoButton"
                    Content="いいえ"
                    Width="80"
                    IsCancel="True"
                    Click="OnNoClick"/>
            
            <Button Name="DetailsButton"
                    Content="詳細"
                    Width="80"
                    Click="OnDetailsClick"
                    IsVisible="{Binding HasChanges}"/>
        </StackPanel>
        
        <!-- メインコンテンツ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="20,20,20,10">
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding ConfirmMessage}"
                           TextWrapping="Wrap"/>
                
                <!-- サブスクライブ/アンサブスクライブ情報 -->
                <StackPanel IsVisible="{Binding HasChanges}"
                            Spacing="5">
                    <TextBlock FontWeight="Bold" Margin="0,10,0,0">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="サブスクライブ: {0}個">
                                <Binding Path="AddonsToSubscribe.Count"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    
                    <TextBlock FontWeight="Bold">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="サブスクライブ解除: {0}個">
                                <Binding Path="AddonsToUnsubscribe.Count"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    
                    <TextBlock Text="※実際のSteam状態に基づいて同期します"
                               FontStyle="Italic"
                               Foreground="Gray"
                               IsVisible="{Binding IsSteamworksAvailable}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>