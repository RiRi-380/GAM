<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:GmodAddonManager.UI.Views"
        xmlns:loc="using:GmodAddonManager.UI.Localization"
        x:Class="GmodAddonManager.UI.Views.SwitchSetsDialog"
        Title="{loc:Localize SwitchSets.Title}"
        Width="690" MinWidth="580" Height="480" MinHeight="370"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18" RowDefinitions="Auto,*,Auto,Auto,Auto">
        <TextBlock Text="{loc:Localize SwitchSets.Explanation}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="views:SwitchSetRow">
                        <Border BorderThickness="0,0,0,1" BorderBrush="#505050" Padding="4,8">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="Bold"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <Button Content="{loc:Localize SwitchSets.Apply}" Click="OnApply"/>
                                    <Button Content="{loc:Localize SwitchSets.Rename}" Click="OnRename"/>
                                    <Button Content="{loc:Localize Dialog.Delete}" Click="OnRequestDelete"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Changes}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Grid Grid.Row="2" x:Name="Editor" Margin="0,12,0,0" ColumnDefinitions="*,Auto,Auto">
            <TextBox x:Name="SetName" Watermark="{loc:Localize SwitchSets.Name}" TextChanged="OnNameChanged"/>
            <Button x:Name="SaveButton" Grid.Column="1" Margin="6,0,0,0" Content="{loc:Localize SwitchSets.Save}" Click="OnSave"/>
            <Button x:Name="CancelRename" Grid.Column="2" Margin="6,0,0,0" IsVisible="False" Content="{loc:Localize Dialog.Cancel}" Click="OnCancelRename"/>
        </Grid>
        <StackPanel Grid.Row="2" x:Name="DeletePrompt" IsVisible="False" Margin="0,12,0,0" Spacing="5">
            <TextBlock x:Name="DeleteMessage" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="{loc:Localize Dialog.Cancel}" Click="OnCancelDelete"/>
                <Button Content="{loc:Localize Dialog.Delete}" Click="OnDelete"/>
            </StackPanel>
        </StackPanel>
        <TextBlock Grid.Row="3" x:Name="Feedback" Margin="0,6,0,0" TextWrapping="Wrap" />
        <Button Grid.Row="4" Content="{loc:Localize Dialog.Close}" HorizontalAlignment="Right" Margin="0,8,0,0" Click="OnClose"/>
    </Grid>
</Window>
