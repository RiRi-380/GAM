<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:GmodAddonManager.UI.Localization"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="250"
        x:Class="GmodAddonManager.UI.Views.AddAddonMethodDialog"
        Title="{loc:Localize AddAddonMethod.Title}"
        Width="400"
        Height="250"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- タイトル -->
        <TextBlock Grid.Row="0" 
                   Text="{loc:Localize AddAddonMethod.Header}" 
                   FontSize="16" 
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>
        
        <!-- オプション -->
        <StackPanel Grid.Row="1" Spacing="15">
            <RadioButton Name="UrlRadioButton" 
                         IsChecked="True"
                         GroupName="AddMethod">
                <StackPanel Spacing="5">
                    <TextBlock Text="{loc:Localize AddAddonMethod.URLInput}" FontWeight="Bold"/>
                    <TextBlock Text="{loc:Localize AddAddonMethod.URLDescription}" 
                               Opacity="0.7" 
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </RadioButton>
            
            <RadioButton Name="SelectRadioButton" 
                         GroupName="AddMethod">
                <StackPanel Spacing="5">
                    <TextBlock Text="{loc:Localize AddAddonMethod.SelectFromList}" FontWeight="Bold"/>
                    <TextBlock Text="{loc:Localize AddAddonMethod.ListDescription}" 
                               Opacity="0.7" 
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </RadioButton>
        </StackPanel>
        
        <!-- ボタン -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Spacing="10">
            <Button Name="OkButton" 
                    Content="{loc:Localize Dialog.OK}" 
                    Width="80"
                    Click="OnOkClick"/>
            <Button Name="CancelButton" 
                    Content="{loc:Localize Dialog.Cancel}" 
                    Width="80"
                    Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</Window>