<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="using:GmodAddonManager.UI.Localization"
        mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="380"
        x:Class="GmodAddonManager.UI.Views.AssetGroupDeleteDialog"
        Title="{loc:Localize AssetGroup.DeleteDialogTitle}"
        Width="540"
        Height="380"
        MinWidth="440"
        MinHeight="330"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Window.Styles>
        <Style Selector="Button.deleteChoice">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="14,11"/>
        </Style>
        <Style Selector="Button.destructive">
            <Setter Property="Background" Value="#8E3035"/>
            <Setter Property="BorderBrush" Value="#C75B62"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.destructive:pointerover">
            <Setter Property="Background" Value="#A63B42"/>
        </Style>
    </Window.Styles>

    <Grid Margin="24" RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="7" Margin="0,0,0,16">
            <TextBlock x:Name="QuestionText"
                       FontSize="20"
                       FontWeight="Bold"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="DescriptionText"
                       Opacity="0.74"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="10">
            <Button x:Name="KeepAssetsButton"
                    Classes="deleteChoice"
                    Click="OnKeepAssets"
                    IsDefault="True">
                <StackPanel Spacing="3">
                    <TextBlock x:Name="KeepAssetsTitleText"
                               Text="{loc:Localize AssetGroup.DeleteOnlyPromoteContents}"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="KeepAssetsDescriptionText"
                               FontSize="11"
                               Opacity="0.72"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Button>

            <Button x:Name="DeleteAssetsButton"
                    Classes="deleteChoice destructive"
                    Click="OnDeleteAssets">
                <StackPanel Spacing="3">
                    <TextBlock Text="{loc:Localize AssetGroup.DeleteWithContents}"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="DeleteAssetsDescriptionText"
                               FontSize="11"
                               Opacity="0.82"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <Button Grid.Row="2"
                Click="OnCancel"
                Content="{loc:Localize Dialog.Cancel}"
                IsCancel="True"
                HorizontalAlignment="Right"
                Margin="0,18,0,0"/>
    </Grid>
</Window>
