<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="using:GmodAddonManager.UI.Localization"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
        x:Class="GmodAddonManager.UI.Views.SettingsDialog"
        Title="{loc:Localize Settings.Title}"
        Width="700"
        Height="600"
        MinWidth="480"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
    
    <DockPanel Margin="30">
        <!-- ヘッダー -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <TextBlock Text="{loc:Localize Settings.Header}" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="{loc:Localize Settings.Description}"
                       Opacity="0.7"
                       Margin="0,5,0,0"
                       TextWrapping="Wrap"/>
            <TextBlock Name="VersionText" Opacity="0.65" FontSize="12" Margin="0,8,0,0"/>
        </StackPanel>
        
        <!-- ボタン -->
        <StackPanel DockPanel.Dock="Bottom" 
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,20,0,0">
            <Button Width="100" Click="OnCancel" Content="{loc:Localize Dialog.Cancel}"/>
            <Button Width="100" Click="OnSave" Classes="accent" Content="{loc:Localize Dialog.Save}"/>
        </StackPanel>
        
        <!-- 設定コンテンツ -->
        <ScrollViewer>
            <StackPanel Spacing="30">
                <!-- 言語設定 -->
                <Border Background="#1F1F1F" CornerRadius="8" Padding="25">
                    <StackPanel Spacing="15">
                        <StackPanel Spacing="5">
                            <TextBlock Text="{loc:Localize Settings.LanguageHeader}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{loc:Localize Settings.LanguageDescription}"
                                       Opacity="0.7"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        
                        <StackPanel Spacing="5">
                            <TextBlock Text="{loc:Localize Settings.DisplayLanguage}" FontWeight="SemiBold"/>
                            <ComboBox Name="LanguageComboBox" 
                                      Width="300" 
                                      HorizontalAlignment="Left"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="{loc:Localize Settings.Japanese}"/>
                                <ComboBoxItem Content="{loc:Localize Settings.English}"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- 詳細設定 -->
                <Border Background="#1F1F1F" CornerRadius="8" Padding="25">
                    <StackPanel Spacing="15">
                        <StackPanel Spacing="5">
                            <TextBlock Text="{loc:Localize Settings.AdvancedHeader}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{loc:Localize Settings.AdvancedDescription}"
                                       Opacity="0.7"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <WrapPanel Orientation="Horizontal">
                            <Button Click="OnPathRecovery"
                                    Width="220"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,10,10">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <PathIcon Data="{StaticResource FolderIcon}" Width="16" Height="16"/>
                                    <TextBlock Text="{loc:Localize Settings.PathRecoveryButton}"/>
                                </StackPanel>
                            </Button>

                            <Button Click="OnPathHealth"
                                    Width="220"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <PathIcon Data="{StaticResource WarningIcon}" Width="16" Height="16"/>
                                    <TextBlock Text="{loc:Localize Settings.PathHealthButton}"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <CheckBox Name="RetainMissingAssetReferencesCheckBox"
                                  Content="{loc:Localize Settings.RetainMissingAssetReferences}"
                                  ToolTip.Tip="{loc:Localize Settings.RetainMissingAssetReferencesDescription}"
                                  Margin="0,5,0,0"/>

                        <StackPanel Spacing="6" Margin="0,8,0,0">
                            <TextBlock Text="{loc:Localize Settings.MaxNestedGroupDepth}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Localize Settings.MaxNestedGroupDepthDescription}"
                                       Opacity="0.75"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                            <NumericUpDown x:Name="MaxNestedGroupDepthNumericUpDown"
                                           Minimum="1"
                                           Maximum="10"
                                           Increment="1"
                                           Value="1"
                                           Width="120"
                                           HorizontalAlignment="Left"/>
                            <TextBlock x:Name="MaxNestedGroupDepthErrorTextBlock"
                                       IsVisible="False"
                                       Foreground="#F08A8A"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- パフォーマンス設定 -->
                <Border Background="#1F1F1F" CornerRadius="8" Padding="25">
                    <StackPanel Spacing="15">
                        <StackPanel Spacing="5">
                            <TextBlock Text="{loc:Localize Settings.PerformanceHeader}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{loc:Localize Settings.PerformanceDescription}"
                                       Opacity="0.7"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        
                        <StackPanel Spacing="10">
                            <CheckBox Name="BackgroundTitleUpdatesCheckBox"
                                      Content="{loc:Localize Settings.EnableBackgroundTitleUpdates}"/>
                            <CheckBox Name="BackgroundAddonPreloadCheckBox"
                                      Content="{loc:Localize Settings.EnableBackgroundAddonPreload}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 試験的設定 -->
                <Border Background="#1F1F1F" CornerRadius="8" Padding="25">
                    <StackPanel Spacing="15">
                        <StackPanel Spacing="5">
                            <TextBlock Text="{loc:Localize Settings.ExperimentalHeader}"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{loc:Localize Settings.ExperimentalDescription}"
                                       Opacity="0.7"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <CheckBox Name="MemberHistoryExperimentalCheckBox"
                                      Content="{loc:Localize Settings.MemberHistoryExperimental}"/>
                            <TextBlock Text="{loc:Localize Settings.MemberHistoryExperimentalDescription}"
                                       Margin="26,0,0,6"
                                       Opacity="0.75"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                            <CheckBox Name="LocalAddonDiscoveryExperimentalCheckBox"
                                      Content="{loc:Localize Settings.LocalAddonDiscoveryExperimental}"/>
                            <TextBlock Text="{loc:Localize Settings.LocalAddonDiscoveryExperimentalDescription}"
                                       Margin="26,0,0,0"
                                       Opacity="0.75"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- ログ設定 -->
                <Border Background="#1F1F1F" CornerRadius="8" Padding="25">
                    <StackPanel Spacing="15">
                        <StackPanel Spacing="5">
                            <TextBlock Text="{loc:Localize Settings.LogHeader}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{loc:Localize Settings.LogDescription}"
                                       Opacity="0.7"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        
                        <StackPanel Spacing="5">
                            <TextBlock Text="{loc:Localize Settings.LogLocation}" FontWeight="SemiBold"/>
                            <TextBlock Name="LogLocationText" 
                                      Opacity="0.8" 
                                      FontSize="12"
                                      TextWrapping="Wrap"
                                      FontFamily="Consolas, monospace"/>
                        </StackPanel>
                        
                        <CheckBox Name="ShowConsoleCheckBox" 
                                  Content="{loc:Localize Settings.ShowConsoleOnStartup}"
                                  Margin="0,10,0,10"/>
                        
                        <Button Click="OnOpenLogFolder" Width="200" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <PathIcon Data="{StaticResource FolderIcon}" Width="16" Height="16"/>
                                <TextBlock Text="{loc:Localize Settings.OpenLogFolder}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                
                <!-- アップデート設定 -->
                <Border Background="#1F1F1F" CornerRadius="8" Padding="25">
                    <StackPanel Spacing="15">
                        <StackPanel Spacing="5">
                            <TextBlock Text="{loc:Localize Settings.UpdateHeader}" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{loc:Localize Settings.UpdateDescription}"
                                       Opacity="0.7"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Click="OnCheckForUpdate" Width="200" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <PathIcon Data="{StaticResource RefreshIcon}" Width="16" Height="16"/>
                                <TextBlock Text="{loc:Localize Settings.CheckForUpdate}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 危険な操作 -->
                <Border Background="#2A1515" BorderBrush="#CC0000" BorderThickness="1" CornerRadius="8" Padding="25">
                    <StackPanel Spacing="15">
                        <StackPanel Spacing="5">
                            <TextBlock Text="{loc:Localize Settings.DangerZoneHeader}" FontSize="18" FontWeight="Bold" Foreground="#FF4444"/>
                            <TextBlock Text="{loc:Localize Settings.DangerZoneDescription}"
                                       Opacity="0.7"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        
                        <Border Background="#1F0A0A" CornerRadius="4" Padding="15">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <PathIcon Data="{StaticResource WarningIcon}" Width="20" Height="20" Foreground="#FF4444"/>
                                    <TextBlock Name="ResetManagerTitleText"
                                               Text="{loc:Localize Settings.ResetManagerTitle}"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               Foreground="#FF4444"/>
                                </StackPanel>
                                <TextBlock x:Name="ResetManagerDescriptionText"
                                           Text="{loc:Localize Settings.ResetManagerDescriptionSoft}"
                                           TextWrapping="Wrap" 
                                           Opacity="0.8"
                                           FontSize="12"/>
                                <TextBlock Text="{loc:Localize Settings.ResetManagerWarning}" 
                                           TextWrapping="Wrap" 
                                           Foreground="#FF9999"
                                           FontSize="11"
                                           FontStyle="Italic"/>
                                <Button Name="ResetManagerButton"
                                        Click="OnResetManager"
                                        Background="#CC0000"
                                        Foreground="White"
                                        Width="200"
                                        HorizontalAlignment="Left"
                                        Margin="0,10,0,0">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover">
                                            <Setter Property="Background" Value="#EE0000"/>
                                        </Style>
                                    </Button.Styles>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <PathIcon Data="{StaticResource DeleteIcon}" Width="16" Height="16"/>
                                        <TextBlock Name="ResetManagerButtonText"
                                                   Text="{loc:Localize Settings.ResetManagerButton}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
