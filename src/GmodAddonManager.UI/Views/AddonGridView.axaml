<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:GmodAddonManager.UI.ViewModels"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:loc="using:GmodAddonManager.UI.Localization"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="GmodAddonManager.UI.Views.AddonGridView"
             x:DataType="vm:AddonGridViewModel">
    
    <UserControl.Resources>
        <!-- アイテムテンプレート -->
        <DataTemplate x:Key="AddonItemTemplate" x:DataType="vm:AddonItemViewModel">
            <Border Width="200" 
                    Height="220" 
                    Margin="8"
                    Padding="10"
                    Background="#1F1F1F"
                    CornerRadius="12"
                    BorderThickness="3"
                    BorderBrush="{Binding BorderColor}"
                    Opacity="{Binding CardOpacity}"
                    ToolTip.Tip="{Binding RuntimeStateTooltip}"
                    AutomationProperties.Name="{Binding Title}"
                    AutomationProperties.HelpText="{Binding RuntimeStateTooltip}"
                    Classes="addonCard"
                    Classes.selected="{Binding IsSelected}"
                    Classes.selectionMode="{Binding $parent[UserControl].DataContext.IsSelectionMode}"
                    Classes.local="{Binding IsLocal}"
                    Focusable="True"
                    KeyDown="OnAddonKeyDown"
                    PointerPressed="OnAddonPointerPressed"
                    DoubleTapped="OnAddonDoubleTapped">
                
                <Border.Styles>
                    <Style Selector="Border">
                        <Setter Property="Transitions">
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.08"/>
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.05"/>
                            </Transitions>
                        </Setter>
                        <Setter Property="BoxShadow" Value="0 4 16 0 #30000000"/>
                        <Setter Property="ClipToBounds" Value="False"/>
                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        <Setter Property="RenderTransform" Value="scale(1)"/>
                    </Style>
                    <Style Selector="Border:pointerover">
                        <Setter Property="Background" Value="#333333"/>
                        <Setter Property="BoxShadow" Value="0 8 20 0 #55000000"/>
                        <Setter Property="RenderTransform" Value="scale(1.02)"/>
                    </Style>
                    <Style Selector="Border.addonCard:focus">
                        <Setter Property="BoxShadow" Value="0 0 0 2 #CC4A90E2"/>
                    </Style>
                    <Style Selector="Border.selected">
                        <Setter Property="BorderThickness" Value="2"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
                    </Style>
                    <Style Selector="Border">
                        <Setter Property="Cursor" Value="Hand"/>
                    </Style>
                    <Style Selector="Border.local">
                        <Setter Property="Cursor" Value="Arrow"/>
                    </Style>
                </Border.Styles>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="150"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- サムネイル -->
                    <Border Grid.Row="0" 
                            Width="150"
                            Height="150" 
                            CornerRadius="8"
                            Margin="0,0,0,5"
                            ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1A1A1A" Offset="0"/>
                                <GradientStop Color="#0A0A0A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <!-- gmpublisher方式: ローディング中 -->
                            <ProgressBar Width="30" Height="30"
                                        IsIndeterminate="True"
                                        IsVisible="{Binding IsThumbnailLoading}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                            
                            <!-- サムネイル画像（Bitmapが存在する場合） -->
                            <Image Source="{Binding ThumbnailBitmap}"
                                   Stretch="UniformToFill"
                                   IsVisible="{Binding ThumbnailBitmap, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <Image.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                                    </Transitions>
                                </Image.Transitions>
                            </Image>

                            <!-- Context notices that require more than the card color -->
                            <StackPanel HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Spacing="3">
                                <Border Background="#CC26394D"
                                        BorderBrush="#805EA8E8"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="4,2"
                                        HorizontalAlignment="Right"
                                        IsVisible="{Binding HasAssetContextNotice}"
                                        ToolTip.Tip="{Binding StateReasonText}">
                                    <TextBlock Text="{Binding AssetContextNoticeText}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="#D8ECFF"/>
                                </Border>
                            </StackPanel>

                            <Border Background="#C97800"
                                    CornerRadius="4"
                                    Padding="4,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    IsVisible="{Binding IsMissing}">
                                <TextBlock Text="{loc:Localize Addon.Missing}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                            </Border>

                            <Border Background="#1565C0"
                                    CornerRadius="4"
                                    Padding="4,2"
                                    HorizontalAlignment="Left"
                                     VerticalAlignment="Top"
                                     IsVisible="{Binding IsLocal}"
                                     ToolTip.Tip="{loc:Localize AddonGrid.LocalReadOnlyReason}">
                                <TextBlock Text="{loc:Localize Addon.Local}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                            </Border>

                        </Grid>
                    </Border>
                    
                    <!-- タイトル -->
                    <TextBlock Grid.Row="1"
                              Text="{Binding Title}"
                              FontWeight="Bold"
                              TextWrapping="Wrap"
                              MaxLines="2"
                              TextTrimming="CharacterEllipsis"
                              VerticalAlignment="Top"
                              ToolTip.Tip="{Binding Title}"/>
                    
                    <!-- 更新日時（左） + サイズ（右） -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                  Text="{Binding SortValueText}"
                                  FontSize="11"
                                  Opacity="0.7"/>
                        <TextBlock Grid.Column="1"
                                  Text="{Binding FileSizeText}"
                                  FontSize="11"
                                  Opacity="0.7"
                                  HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
        
        <!-- UniformGridLayout -->
        <UniformGridLayout x:Key="UniformGridLayout"
                          MinColumnSpacing="10"
                          MinRowSpacing="10"
                          MinItemWidth="200"
                          MinItemHeight="220"
                          ItemsJustification="Start"
                          ItemsStretch="None"/>
    </UserControl.Resources>
    
    <DockPanel>
        <!-- ヘッダー -->
        <Border DockPanel.Dock="Top" 
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                Padding="15"
                BoxShadow="0 2 4 0 #10000000">
            <Grid RowDefinitions="Auto,Auto"
                  RowSpacing="10">
                <Grid Grid.Row="0"
                      ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{loc:Localize AddonGrid.Header}"
                               FontSize="16"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Opacity="0.7"
                               Text="{Binding AddonCountDisplay}"
                               TextWrapping="Wrap"/>
                    <Button Grid.Column="2"
                            Name="FilterPaneToggleButton"
                            Click="OnFilterPaneToggleClick"
                            ToolTip.Tip="{loc:Localize AddonGrid.OpenFilters}"
                            AutomationProperties.Name="{loc:Localize AddonGrid.OpenFilters}"
                            Width="32"
                            Height="32"
                            IsVisible="False">
                        <TextBlock Text="☷" FontSize="16"/>
                    </Button>
                </Grid>

                <WrapPanel Grid.Row="1"
                           Orientation="Horizontal"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                Margin="0,0,12,6"
                                VerticalAlignment="Center">
                        <TextBlock Text="{loc:Localize AddonGrid.FilterStateLabel}"
                                   FontSize="12"
                                   Opacity="0.7"
                                   VerticalAlignment="Center"/>
                        <!-- State filter -->
                        <ComboBox SelectedIndex="{Binding AddonFilterIndex}"
                                  MinWidth="110"
                                  Height="26"
                                  VerticalContentAlignment="Center">
                            <ComboBoxItem Content="{loc:Localize AddonGrid.FilterAll}"/>
                            <ComboBoxItem Content="{loc:Localize AddonGrid.FilterEnabled}"/>
                            <ComboBoxItem Content="{loc:Localize AddonGrid.FilterDisabled}"/>
                        </ComboBox>
                    </StackPanel>

                    <CheckBox Content="{loc:Localize AddonGrid.ShowCurrentAssetOnly}"
                              IsChecked="{Binding ShowOnlyAssetAddons}"
                              Margin="0,0,12,6"
                              VerticalAlignment="Center"/>

                    <!-- 選択モードトグル -->
                    <ToggleButton IsChecked="{Binding IsSelectionMode}"
                                  MinWidth="110"
                                  Height="32"
                                  Margin="0,0,8,6"
                                  Padding="10,0"
                                  VerticalContentAlignment="Center"
                                  VerticalAlignment="Center"
                                  Classes.accent="{Binding IsSelectionMode}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource EnabledIcon}"
                                      Width="14" Height="14"
                                      VerticalAlignment="Center"
                                      IsVisible="{Binding IsSelectionMode}"/>
                            <TextBlock Text="{loc:Localize AddonGrid.SelectionMode}"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- 一括選択ボタン -->
                    <Button Command="{Binding SelectAllCommand}"
                            IsVisible="{Binding IsSelectionMode}"
                            MinWidth="90"
                            Height="32"
                            Margin="0,0,8,6"
                            Padding="10,0"
                            VerticalContentAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource CheckIcon}"
                                      Width="14"
                                      Height="14"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Localize AddonGrid.BulkSelect}"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 選択したアドオンを転送 -->
                    <Button Command="{Binding AddSelectedAddonsCommand}"
                            IsEnabled="{Binding HasSelectedAddons}"
                            IsVisible="{Binding IsSelectionMode}"
                            MinWidth="140"
                            Height="32"
                            Margin="0,0,8,6"
                            Padding="10,0"
                            VerticalContentAlignment="Center"
                            VerticalAlignment="Center"
                            Classes="accent">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource MoveIcon}"
                                      Width="14"
                                      Height="14"
                                      VerticalAlignment="Center"/>
                            <TextBlock FontSize="12"
                                       VerticalAlignment="Center"
                                       Text="{Binding SelectionActionLabel}"/>
                        </StackPanel>
                    </Button>

                    <!-- アセットから削除 -->
                    <Button Command="{Binding RemoveSelectedAddonsCommand}"
                            IsEnabled="{Binding CanRemoveFromAsset}"
                            IsVisible="{Binding IsSelectionMode}"
                            MinWidth="140"
                            Height="32"
                            Margin="0,0,8,6"
                            Padding="10,0"
                            VerticalContentAlignment="Center"
                            VerticalAlignment="Center"
                            Classes="danger">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource DeleteIcon}"
                                      Width="14"
                                      Height="14"
                                      VerticalAlignment="Center"/>
                            <TextBlock FontSize="12"
                                       VerticalAlignment="Center"
                                       Text="{Binding SelectionDeleteLabel}"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>
        
        <!-- ローディング表示 -->
        <ProgressBar DockPanel.Dock="Top"
                    IsIndeterminate="True"
                    Height="3"
                    IsVisible="{Binding IsLoading}"/>
        
        <SplitView Name="FilterSplitView"
                   DisplayMode="Inline"
                   PanePlacement="Right"
                   OpenPaneLength="250"
                   CompactPaneLength="0"
                   IsPaneOpen="True"
                   PaneOpening="OnFilterPaneOpening"
                   PaneClosed="OnFilterPaneClosed">
            <SplitView.Pane>
                <!-- 並び替え・フィルターサイドバー -->
                <Border Name="FilterPaneContent"
                        Background="#1B1B1B"
                        BorderBrush="#2C2C2C"
                        BorderThickness="1,0,0,0"
                        Padding="12">
                    <Grid RowDefinitions="Auto,*">
                        <Button Grid.Row="0"
                                Name="FilterPaneCloseButton"
                                Click="OnFilterPaneToggleClick"
                                ToolTip.Tip="{loc:Localize AddonGrid.CloseFilters}"
                                AutomationProperties.Name="{loc:Localize AddonGrid.CloseFilters}"
                                HorizontalAlignment="Right"
                                Width="32"
                                Height="32"
                                Margin="0,0,0,8"
                                IsVisible="False">
                            <TextBlock Text="×" FontSize="18"/>
                        </Button>

                        <ScrollViewer Grid.Row="1"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Localize VersionManagement.SortOrderLabel}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Opacity="0.8"/>
                                <ComboBox ItemsSource="{Binding SortModeOptions}"
                                          SelectedIndex="{Binding SelectedSortModeIndex}"
                                          MinHeight="32"
                                          HorizontalAlignment="Stretch"
                                          VerticalContentAlignment="Center"/>
                                <Button Command="{Binding ToggleSortDirectionCommand}"
                                        Content="{Binding SortDirectionLabel}"
                                        MinHeight="32"
                                        Padding="10,4"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Localize AddonGrid.FilterTypeHeader}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Opacity="0.8"/>
                                <ItemsControl ItemsSource="{Binding AddonTypeFilters}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="4"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FilterOptionViewModel">
                                            <CheckBox Content="{Binding Label}"
                                                      IsChecked="{Binding IsSelected}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Localize AddonGrid.FilterTagHeader}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Opacity="0.8"/>
                                <ItemsControl ItemsSource="{Binding AddonTagFilters}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="4"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FilterOptionViewModel">
                                            <CheckBox Content="{Binding Label}"
                                                      IsChecked="{Binding IsSelected}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </SplitView.Pane>

            <!-- アドオングリッド（仮想化） -->
            <Grid>
                <ScrollViewer Name="AddonScrollViewer"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              ClipToBounds="True"
                              Padding="6,6,0,6">
                    <ScrollViewer.Styles>
                        <Style Selector="ScrollViewer">
                            <Setter Property="AllowAutoHide" Value="False"/>
                            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                        </Style>
                    </ScrollViewer.Styles>
                    <ItemsRepeater Name="AddonItemsRepeater"
                                   ItemsSource="{Binding FilteredAddons}"
                                   Layout="{StaticResource UniformGridLayout}"
                                   ItemTemplate="{StaticResource AddonItemTemplate}"
                                   Margin="5,5,0,5">
                        <ItemsRepeater.Styles>
                            <Style Selector="ItemsRepeater">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ItemsRepeater.Styles>
                    </ItemsRepeater>
                </ScrollViewer>
                
                <!-- 空の状態表示 -->
                <TextBlock Text="{loc:Localize AddonGrid.NoAddonsFound}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Opacity="0.5">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!FilteredAddonsCount"/>
                            <Binding Path="!IsLoading"/>
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>
            </Grid>
        </SplitView>
    </DockPanel>
</UserControl>
