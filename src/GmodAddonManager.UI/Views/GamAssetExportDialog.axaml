<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="using:GmodAddonManager.UI.Localization"
        mc:Ignorable="d"
        d:DesignWidth="520"
        d:DesignHeight="390"
        x:Class="GmodAddonManager.UI.Views.GamAssetExportDialog"
        Title="{loc:Localize GamAssetFile.ExportTitle}"
        Width="520"
        Height="390"
        MinWidth="420"
        MinHeight="280"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="24" RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock x:Name="AssetNameTextBlock"
                       FontSize="20"
                       FontWeight="Bold"
                       MaxLines="1"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding #AssetNameTextBlock.Text}"/>
            <TextBlock Text="{loc:Localize GamAssetFile.ExportDescription}"
                       Opacity="0.78"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,18,0,18"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Border Padding="16"
                    CornerRadius="8"
                    Background="{DynamicResource SystemControlBackgroundListLowBrush}">
                <StackPanel Spacing="8">
                    <CheckBox x:Name="IncludeImageCheckBox"
                              Content="{loc:Localize GamAssetFile.IncludeImage}"/>
                    <TextBlock x:Name="ImageDescriptionTextBlock"
                               Margin="26,0,0,0"
                               Opacity="0.7"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                    <CheckBox x:Name="IncludeMemoCheckBox"
                              Margin="0,8,0,0"
                              Content="{loc:Localize GamAssetFile.IncludeMemo}"/>
                    <TextBlock x:Name="MemoDescriptionTextBlock"
                               Margin="26,0,0,0"
                               Opacity="0.7"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:Localize GamAssetFile.NoSteamChanges}"
                               Margin="0,8,0,0"
                               Opacity="0.8"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="ExportDialogErrorTextBlock"
                               IsVisible="False"
                               Foreground="#F08A8A"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10">
            <Button Content="{loc:Localize Dialog.Cancel}"
                    IsCancel="True"
                    Click="OnCancel"/>
            <Button Content="{loc:Localize GamAssetFile.ChooseAndExport}"
                    Classes="accent"
                    IsDefault="True"
                    Click="OnExport"/>
        </StackPanel>
    </Grid>
</Window>
