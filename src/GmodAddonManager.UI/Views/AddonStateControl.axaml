<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="30"
             x:Class="GmodAddonManager.UI.Views.AddonStateControl">
    
    <Border Background="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}"
            CornerRadius="15"
            Padding="2">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- 有効ボタン -->
            <RadioButton Grid.Column="0"
                         Name="EnabledButton"
                         GroupName="AddonState"
                         IsChecked="{Binding IsEnabled}"
                         HorizontalAlignment="Stretch"
                         HorizontalContentAlignment="Center"
                         Classes="state-button enabled">
                <TextBlock Text="有効" FontSize="12"/>
            </RadioButton>
            
            <!-- 無効ボタン -->
            <RadioButton Grid.Column="1"
                         Name="DisabledButton"
                         GroupName="AddonState"
                         IsChecked="{Binding IsDisabled}"
                         HorizontalAlignment="Stretch"
                         HorizontalContentAlignment="Center"
                         Classes="state-button disabled">
                <TextBlock Text="無効" FontSize="12"/>
            </RadioButton>
            
            <!-- 除外ボタン -->
            <RadioButton Grid.Column="2"
                         Name="ExcludedButton"
                         GroupName="AddonState"
                         IsChecked="{Binding IsExcluded}"
                         HorizontalAlignment="Stretch"
                         HorizontalContentAlignment="Center"
                         Classes="state-button excluded">
                <TextBlock Text="除外" FontSize="12"/>
            </RadioButton>
        </Grid>
    </Border>
    
    <UserControl.Styles>
        <Style Selector="RadioButton.state-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="13"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        
        <Style Selector="RadioButton.state-button:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
        </Style>
        
        <Style Selector="RadioButton.state-button:checked /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
        </Style>
        
        <Style Selector="RadioButton.state-button.enabled:checked /template/ Border#PART_Border">
            <Setter Property="Background" Value="#4A90E2"/>
        </Style>
        
        <Style Selector="RadioButton.state-button.disabled:checked /template/ Border#PART_Border">
            <Setter Property="Background" Value="#FF757575"/>
        </Style>
        
        <Style Selector="RadioButton.state-button.excluded:checked /template/ Border#PART_Border">
            <Setter Property="Background" Value="#FFF44336"/>
        </Style>
        
        <Style Selector="RadioButton.state-button:checked TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Styles>
</UserControl>