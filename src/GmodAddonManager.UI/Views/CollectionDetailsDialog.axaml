<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="using:GmodAddonManager.UI.Localization"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="GmodAddonManager.UI.Views.CollectionDetailsDialog"
        Title="{loc:Localize Collection.Details}"
        Width="800"
        Height="600"
        WindowStartupLocation="CenterOwner">
    
    <DockPanel>
        <!-- ヘッダー -->
        <Border DockPanel.Dock="Top" 
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- コレクション画像 -->
                <Border Grid.Column="0"
                        Width="80"
                        Height="80"
                        CornerRadius="8"
                        ClipToBounds="True"
                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                        Margin="0,0,15,0">
                    <Image x:Name="CollectionImage"
                           Source="{Binding CollectionImageBitmap}"
                           Stretch="UniformToFill"/>
                </Border>
                
                <!-- コレクション情報 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CollectionTitle}" 
                               FontSize="24" 
                               FontWeight="Bold"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding CollectionDescription}" 
                               FontSize="14"
                               Opacity="0.8"
                               TextWrapping="Wrap"
                               MaxHeight="40"
                               Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding AddonCountText}" 
                               FontSize="12"
                               Opacity="0.6"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- ローディング -->
        <ProgressBar DockPanel.Dock="Top"
                     IsIndeterminate="True"
                     Height="2"
                     IsVisible="{Binding IsLoading}"/>
        
        <!-- ボタン -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}"
                Padding="20">
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Right"
                        Spacing="10">
                <Button Content="{loc:Localize Dialog.Cancel}"
                        Click="OnCancel"/>
                <Button Content="{loc:Localize Collection.Import}"
                        IsEnabled="{Binding CanImport}"
                        IsVisible="{Binding ShowSubscribeActions}"
                        Click="OnImport"
                        Classes="accent"/>
            </StackPanel>
        </Border>
        
        <!-- アドオンリスト -->
        <ScrollViewer>
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Addons}" 
                              Margin="20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,4"
                                Padding="15"
                                Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- アドオン画像 -->
                                <Border Grid.Column="0"
                                        Width="50"
                                        Height="50"
                                        CornerRadius="4"
                                        ClipToBounds="True"
                                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                    <Image Source="{Binding ThumbnailBitmap}"
                                           Stretch="UniformToFill"/>
                                </Border>
                                
                                <!-- アドオン情報 -->
                                <StackPanel Grid.Column="1" 
                                            Margin="15,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" 
                                               FontWeight="Bold"
                                               FontSize="14"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Author}" 
                                               FontSize="12"
                                               Opacity="0.7"
                                               Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding SizeText}" 
                                               FontSize="11"
                                               Opacity="0.5"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                
                                <!-- ステータス -->
                                <StackPanel Grid.Column="2" 
                                            VerticalAlignment="Center"
                                            Margin="10,0,0,0"
                                            IsVisible="{Binding $parent[Window].DataContext.ShowSubscribeActions}">
                                    <Border Background="{Binding StatusColor}"
                                            CornerRadius="3"
                                            Padding="8,4">
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="11"
                                                   Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
            <!-- さらに表示ボタン -->
            <Button Grid.Row="1"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,10"
                    Padding="20,8"
                    IsVisible="{Binding HasMoreItems}"
                    Click="OnLoadMoreClick">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="{loc:Localize Collection.LoadMore}" 
                               VerticalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True"
                                 IsVisible="{Binding IsLoadingMore}"
                                 Width="20"
                                 Height="20"
                                 VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
