<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:GmodAddonManager.UI.ViewModels"
        xmlns:loc="using:GmodAddonManager.UI.Localization"
        mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="680"
        x:Class="GmodAddonManager.UI.Views.PathHealthDialog"
        x:DataType="vm:PathHealthViewModel"
        Title="{loc:Localize PathHealth.Title}"
        Width="820"
        Height="680"
        MinWidth="760"
        MinHeight="620"
        CanResize="True"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22" RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="{loc:Localize PathHealth.Title}" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="{loc:Localize PathHealth.Description}" TextWrapping="Wrap" Opacity="0.78"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,18,0,18">
            <StackPanel Spacing="14">
                <Border Background="#242424" BorderBrush="#444444" BorderThickness="1" CornerRadius="6" Padding="16">
                    <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{loc:Localize PathHealth.CurrentPaths}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Localize PathHealth.SteamRoot}" Opacity="0.66"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentSteamRoot}" TextWrapping="Wrap" FontFamily="Consolas, monospace"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Localize PathHealth.GmodInstall}" Opacity="0.66" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentGmodInstall}" TextWrapping="Wrap" FontFamily="Consolas, monospace" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Localize PathHealth.WorkshopRoot}" Opacity="0.66" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CurrentWorkshopRoot}" TextWrapping="Wrap" FontFamily="Consolas, monospace" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Localize PathHealth.CachePath}" Opacity="0.66" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CurrentCachePath}" TextWrapping="Wrap" FontFamily="Consolas, monospace" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Localize PathHealth.AddonNoMount}" Opacity="0.66" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CurrentAddonNoMountPath}" TextWrapping="Wrap" FontFamily="Consolas, monospace" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="{loc:Localize PathHealth.PreviousGmod}" Opacity="0.66" Margin="0,14,0,0"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding PreviousGmodInstall}" TextWrapping="Wrap" FontFamily="Consolas, monospace" Margin="0,14,0,0"/>
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="{loc:Localize PathHealth.PreviousWorkshop}" Opacity="0.66" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding PreviousWorkshopRoot}" TextWrapping="Wrap" FontFamily="Consolas, monospace" Margin="0,8,0,0"/>
                    </Grid>
                </Border>

                <Border Background="#1F2A33" BorderBrush="#35516A" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{loc:Localize PathHealth.Issues}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding IssueSummary}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="#242424" BorderBrush="#444444" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{loc:Localize PathHealth.SafeRepairs}" FontSize="16" FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3">
                                <TextBlock Text="{loc:Localize PathHealth.MetadataRepair}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding MetadataRepairSummary}" TextWrapping="Wrap" Opacity="0.76"/>
                            </StackPanel>
                            <Button Grid.Row="0" Grid.Column="1" MinWidth="120" Content="{loc:Localize PathHealth.Apply}" IsEnabled="{Binding CanRepairMetadata}" Click="OnRepairMetadata"/>

                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="3">
                                <TextBlock Text="{loc:Localize PathHealth.AddonNoMountMigration}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding AddonNoMountSummary}" TextWrapping="Wrap" Opacity="0.76"/>
                            </StackPanel>
                            <Button Grid.Row="1" Grid.Column="1" MinWidth="120" Content="{loc:Localize PathHealth.Apply}" IsEnabled="{Binding CanMigrateAddonNoMount}" Click="OnMigrateAddonNoMount"/>

                            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="3">
                                <TextBlock Text="{loc:Localize PathHealth.ManagedMigration}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ManagedMigrationSummary}" TextWrapping="Wrap" Opacity="0.76"/>
                            </StackPanel>
                            <Button Grid.Row="2" Grid.Column="1" MinWidth="120" Content="{loc:Localize PathHealth.Move}" IsEnabled="{Binding CanMigrateManagedData}" Click="OnMigrateManagedData"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto">
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.84"/>
            <Button Grid.Column="1" Content="{loc:Localize PathHealth.Refresh}" MinWidth="92" Margin="0,0,10,0" Click="OnRefresh"/>
            <Button Grid.Column="2" Content="{loc:Localize Dialog.Close}" MinWidth="88" Click="OnClose"/>
        </Grid>
    </Grid>
</Window>
