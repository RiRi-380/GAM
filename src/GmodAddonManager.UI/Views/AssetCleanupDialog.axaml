<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="using:GmodAddonManager.UI.Localization"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
        x:Class="GmodAddonManager.UI.Views.AssetCleanupDialog"
        Title="{loc:Localize AssetCleanup.Title}"
        Width="600"
        Height="500"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    
    <DockPanel Margin="20">
        <!-- ヘッダー -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <TextBlock Text="{Binding AssetName}" 
                       FontSize="18" 
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>
            <TextBlock Text="{loc:Localize AssetCleanup.Description}"
                       TextWrapping="Wrap"
                       Opacity="0.8"/>
        </StackPanel>
        
        <!-- ボタン -->
        <StackPanel DockPanel.Dock="Bottom" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Spacing="10"
                    Margin="0,20,0,0">
            <Button Name="PreviewButton"
                    Content="{loc:Localize AssetCleanup.Preview}"
                    Width="100"
                    Click="OnPreviewClick"/>
            <Button Name="CleanupButton"
                    Content="{loc:Localize AssetCleanup.Cleanup}"
                    Width="100"
                    IsEnabled="False"
                    IsDefault="True"
                    Click="OnCleanupClick"/>
            <Button Name="CancelButton"
                    Content="{loc:Localize Common.Cancel}"
                    Width="100"
                    IsCancel="True"
                    Click="OnCancelClick"/>
        </StackPanel>
        
        <!-- メインコンテンツ -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- オプション -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,0,15">
                <StackPanel Spacing="10">
                    <TextBlock Text="{loc:Localize AssetCleanup.CleanupOptions}"
                               FontWeight="Bold"
                               Margin="0,0,0,5"/>
                    
                    <RadioButton Name="ExcludedOnlyRadio"
                                 GroupName="CleanupType"
                                 IsChecked="True">
                        <StackPanel>
                            <TextBlock Text="{loc:Localize AssetCleanup.ExcludedOnly}"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{loc:Localize AssetCleanup.ExcludedOnlyDesc}"
                                       FontSize="12"
                                       Opacity="0.7"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </RadioButton>
                    
                    <RadioButton Name="DisabledAndExcludedRadio"
                                 GroupName="CleanupType">
                        <StackPanel>
                            <TextBlock Text="{loc:Localize AssetCleanup.DisabledAndExcluded}"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{loc:Localize AssetCleanup.DisabledAndExcludedDesc}"
                                       FontSize="12"
                                       Opacity="0.7"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>
            
            <!-- 統計情報 -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,0,15"
                    IsVisible="{Binding HasPreviewData}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding TotalAddonsCount}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{loc:Localize AssetCleanup.TotalAddons}"
                                   FontSize="12"
                                   Opacity="0.7"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding ToUnsubscribeCount}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#F44336"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{loc:Localize AssetCleanup.ToUnsubscribe}"
                                   FontSize="12"
                                   Opacity="0.7"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding ToKeepCount}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#4CAF50"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{loc:Localize AssetCleanup.ToKeep}"
                                   FontSize="12"
                                   Opacity="0.7"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- プレビューリスト -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    IsVisible="{Binding HasPreviewData}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0"
                            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                            Padding="10,5">
                        <TextBlock Text="{loc:Localize AssetCleanup.PreviewList}"
                                   FontWeight="Bold"/>
                    </Border>
                    
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PreviewItems}"
                                      Margin="10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="5,3"
                                            Background="{Binding BackgroundColor}"
                                            CornerRadius="4"
                                            Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding StatusIcon}"
                                                       Margin="0,0,10,0"
                                                       VerticalAlignment="Center"/>
                                            
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Reason}"
                                                           FontSize="11"
                                                           Opacity="0.7"/>
                                            </StackPanel>
                                            
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Action}"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding ActionColor}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
            
            <!-- 初期メッセージ -->
            <Border Grid.Row="2"
                    IsVisible="{Binding !HasPreviewData}"
                    Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                    CornerRadius="8">
                <TextBlock Text="{loc:Localize AssetCleanup.NoPreview}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.5"
                           FontStyle="Italic"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>