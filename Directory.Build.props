<Project>
  <PropertyGroup>
    <Authors>Gmod Addon Manager Team</Authors>
    <Product>Gmod Addon Manager</Product>
    <Copyright>Copyright © 2025-2026</Copyright>
    <Version>2.0.2</Version>
    <FileVersion>2.0.2.0</FileVersion>
    <AssemblyVersion>2.0.2.0</AssemblyVersion>
    <InformationalVersion>v2.0.2</InformationalVersion>
    <NeutralLanguage>en-US</NeutralLanguage>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Reproducible dependency resolution and fail-closed vulnerability auditing. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <!-- The supported distribution target is Windows x64; declaring it keeps
         locked restore and the self-contained publish graph identical. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GAM_PREVIEW)' == 'true'">
    <!-- Isolate preview builds to a temp location to avoid locked repo outputs. -->
    <PreviewProjectName>$([System.IO.Path]::GetFileNameWithoutExtension('$(MSBuildProjectFile)'))</PreviewProjectName>
    <BaseOutputPath>$(TEMP)\gam-preview-out\$(PreviewProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(TEMP)\gam-preview-obj\$(PreviewProjectName)\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Safety: never compile generated bin/obj sources if they leak into item globs. -->
    <Compile Remove="bin\\**;obj\\**" />
    <EmbeddedResource Remove="bin\\**;obj\\**" />
    <None Remove="bin\\**;obj\\**" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Ensure default excludes still cover build outputs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**\bin\**;**\obj\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
