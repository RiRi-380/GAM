# Preserve upstream and audited notice bytes so release hash checks are stable.
# Their original CRLF/trailing whitespace is validated by SHA-256, not Git's
# source-formatting whitespace rules.
THIRD-PARTY-NOTICES.txt -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
MICROSOFT-DOTNET-LIBRARY-LICENSE.txt -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
MICROSOFT-DOTNET-THIRD-PARTY-NOTICES.txt -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
